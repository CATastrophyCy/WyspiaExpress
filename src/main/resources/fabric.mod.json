{
  "schemaVersion": 1,
  "id": "wyspiaexpress",
  "version": "${version}",

  "name": "WyspiaExpress",
  "description": "A mod to overwrite noelle's roles, starry express, stupid express and kin's wathe custom role shop with a configurable one. ",
  "authors": ["CATastrophy"],
  "contact": {},

  "license": "All-Rights-Reserved",
  "icon": "assets/wyspiaexpress/icon.png",

  "environment": "*",
  "entrypoints": {
    "fabric-datagen": ["org.cat.express.wyspiaexpress.client.WyspiaexpressDataGenerator"],
    "client": ["org.cat.express.wyspiaexpress.client.WyspiaexpressClient"],
    "main": [
      "org.cat.express.wyspiaexpress.WyspiaExpress"
    ],
    "cardinal-components": ["org.cat.express.wyspiaexpress.WyspiaExpressComponents"],
    "controlify": [
      "org.cat.express.wyspiaexpress.client.compat.WatheControlifyPlugin"
    ]
  },
  "custom": {
    "cardinal-components": [
      "wyspiaexpress:ability_cooldown",
      "wyspiaexpress:player_depressed_component",
      "wyspiaexpress:player_freeze_component",
      "wyspiaexpress:lich_revive_component",
      "wyspiaexpress:player_role_pick_component",
      "wyspiaexpress:player_body",
      "wyspiaexpress:sense_dead",
      "wyspiaexpress:world_component"
    ]
  },

  "mixins": [
    "wyspiaexpress.mixins.json"
    ,{
      "config": "wyspiaexpress.client.mixins.json",
      "environment": "client"
    }
  ],

  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}"
  },
  "suggests": {
    "controlify": "*"
  }
}
