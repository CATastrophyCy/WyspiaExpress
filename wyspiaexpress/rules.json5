{
	"inventoryTrash": {
		// Allow players to delete selected items from their inventory during a game
		"enabled": true,
		// Items that can be deleted. Gamemode overrides replace this list
		"items": [
			"wathe:key", "wyspiaexpress:fake_revolver", "noellesroles:fake_knife",
			"wathe:scorpion", "wathe:poison_vial", "noellesroles:delusion_vial", "wathe:body_bag",
			"wyspiaexpress:megaphone", "wathe:note", "wathe:firecracker"
		]
	},
	// Multiply to crawling speed. i.e. 1.5 means crawling is 50% faster
	"crawlSpeedMultiplier": 2.2,
	// By setting this to true shooting a protected player won't drop your revolver regardless if they are innocent or not
	"disableProtectionGunDrop": true,
	// Maximum time left, in minutes, for a civilian death or conversion to add time. -1 disables the limit
	"maxTimeForDeathBonus": 7,
	// Player stun tick after blocking damage
	"blockStunTicks": 50,
	// Player stun tick after blocking damage with psycho mode
	"psychoStunTicks": 20,
	"psycho": {
		// Enable infinite psycho shield, slow and time loss from hits. Duration and cooldowns always apply
		"rework": true,
		// Psycho duration, in seconds
		"duration": 50,
		// Blocked hits before the slow and duration penalties start
		"freeHits": 0,
		// Movement slow per hit after the free hits. 0.15 = 15%
		"slowPerHit": 0.15,
		// Maximum movement slow. 0.4 = 40%
		"maxSlow": 0.4,
		// Fraction of remaining psycho time removed per hit after the free hits. 0.35 = 35%
		"timeLostPerHit": 0.35,
		// Weapon cooldown after getting hit in psycho, in seconds. Longer cooldowns are kept
		"weaponCooldown": 15,
		// Extra bat recharge time per hit after the free hits, in seconds
		"batDelayPerHit": 0.5,
		// Maximum extra bat recharge time, in seconds
		"maxBatDelay": 1.5
	},
	// Enable freezing
	"freeze": true,
	// The time, in seconds, it takes for a player to die when staying outside for too long
	"freezeTimer": 75,
	// Enable depression killing
	"depressionKilling": true,
	// The time, in seconds, it takes for a player to die when staying depressed for too long
	"depressedTimer": 90,
	// Whether to enable item bound checking, this will make out of bound item tp to closest dead body
	"enableItemBoundChecking": true,
	// Enable killer having role color instinct on killer-aligned neutrals
	"killerSpecialInstinct": false,
	// Killer instinct brightness. 0 keeps normal darkness, 1 matches spectators
	"killerInstinctBrightness": 0.5
}
